{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "composite": true
  },
  "include": ["src"],
  "exclude": ["src/_*.ts"],
  "references": [
    { "path": "../shared" }
  ]
}
