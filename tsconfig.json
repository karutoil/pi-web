// Root tsconfig — solution file for tsc -b project references.
// Not a build target itself; only used to orchestrate child projects.
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/server" },
    { "path": "packages/client" }
  ],
  "include": [],
  "exclude": ["node_modules", "dist"]
}
