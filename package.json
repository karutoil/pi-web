{
  "name": "pi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "dev:client": "bun run --cwd packages/client dev",
    "build": "bun run --cwd packages/client build",
    "start": "bun run packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
