{
  "name": "pi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "PORT=3069 bun run --cwd packages/server dev",
    "dev:client": "CLIENT_PORT=3070 bun run --cwd packages/client dev",
    "build": "tsc -b && bun run --cwd packages/client build",
    "start": "concurrently -n server,client -c blue,green \"PORT=3068 bun run dev:server\" \"SERVER_PORT=3068 CLIENT_PORT=3071 bun run dev:client\"",
    "start:prod": "bun run --cwd packages/server start",
    "generate-icons": "bun run --cwd packages/client generate-icons",
    "docker:build": "docker build -t pi-web .",
    "docker:start": "./scripts/docker-start.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0"
  }
}
